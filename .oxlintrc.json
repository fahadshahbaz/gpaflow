{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["react", "nextjs", "typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "warn"
	},
	"rules": {
		"no-unused-vars": "warn",
		"nextjs/no-img-element": "off"
	},
	"env": {
		"builtin": true,
		"browser": true,
		"node": true
	},
	"ignorePatterns": ["**/node_modules/**", "**/.next/**", "**/dist/**", "**/build/**"]
}
